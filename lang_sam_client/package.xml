<?xml version="1.0"?>
<package format="2">
  <name>lang_sam_client</name>
  <version>0.0.1</version>
  <description>Robot-side client that streams camera frames to remote LangSAM/Cutie and visualizes the results</description>
  <maintainer email="babaryusei.kw@gmail.com">Ryusei Baba</maintainer>
  <license>Apache 2.0</license>

  <!-- ビルドツール依存 -->
  <buildtool_depend>catkin</buildtool_depend>

  <!-- ビルド時依存 -->
  <build_depend>python3-dev</build_depend>

  <!-- 実行時に必要な依存(推論は行わないためtorchは不要) -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>lang_sam_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- 外部Pythonパッケージ -->
  <exec_depend>python3-pip</exec_depend> <!-- supervision(可視化)インストール用 -->

  <export>
  </export>
</package>
